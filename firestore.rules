rules_version = '2';

// P0 時点の仮ルール。クライアントからの読み書きはすべて拒否する。
// 読み取りの許可は P1 で設計書 5.1 の「読める人」に沿って追加する。
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    // 7.4 検証用（P0 のみ。P1 で削除する）
    match /verify/mfa {
      allow read: if request.auth != null
        && request.auth.token.firebase.sign_in_second_factor == 'totp';
    }
    match /verifyLive/{id} {
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/events/e1).data.state == 'open';
    }
  }
}
