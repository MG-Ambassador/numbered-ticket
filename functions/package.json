{
  "name": "functions",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "npm run typecheck && esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=lib/index.js --external:firebase-admin --external:firebase-functions --sourcemap",
    "gcp-build": "echo 'bundled locally; nothing to build'"
  },
  "dependencies": {
    "firebase-admin": "^14.5.1",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "~5.9.3"
  }
}
